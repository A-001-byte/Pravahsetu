# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Environment ----
ENVIRONMENT=development

# ---- Database (PostgreSQL) ----
# Used by the backend (Module 6) once it's built.
POSTGRES_USER=pravahasetu
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pravahasetu
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pravahasetu:changeme@localhost:5432/pravahasetu

# ---- Backend (FastAPI) ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# ---- Frontend (React + Vite) ----
VITE_API_BASE_URL=http://localhost:8000

# ---- External data sources ----
# Fill in only if/when the relevant portal requires a key for programmatic
# access. Most historical records are pulled as manual exports for now
# (see SETUP.md > Data).
IMD_API_KEY=
CWC_API_KEY=
